{
  "name": "fairshare-client",
  "version": "0.1.0",
  "description": "Fair-share rate limiting client: talks to Redis directly and runs the same Lua scripts as the rate limiter service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./hono": { "types": "./dist/hono.d.ts", "default": "./dist/hono.js" },
    "./express": { "types": "./dist/express.d.ts", "default": "./dist/express.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "hono": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "hono": "^4.8.2",
    "ioredis": "^5.4.1",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}

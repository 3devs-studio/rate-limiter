{
  "name": "fairshare/client",
  "description": "Fair-share rate limiting client: talks to Redis directly and runs the same Lua scripts as the rate limiter service.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "predis/predis": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "psr/http-server-middleware": "^1.0",
    "psr/http-factory": "^1.0",
    "nyholm/psr7": "^1.8"
  },
  "suggest": {
    "psr/http-server-middleware": "For the PSR-15 middleware",
    "psr/http-factory": "For the PSR-15 middleware",
    "laravel/framework": "For the Laravel middleware"
  },
  "autoload": { "psr-4": { "Fairshare\\": "src/" } },
  "autoload-dev": { "psr-4": { "Fairshare\\Tests\\": "tests/" } }
}
